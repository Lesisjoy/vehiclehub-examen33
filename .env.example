API_MOTOS_URL=http://IP_PUBLICA_EC2_ALUMNO3:8000/api/motocicletas

# Se envía desde Vercel como X-API-Key. Ambas APIs deben validarlo.
API_PROXY_TOKEN=REEMPLAZAR_POR_SECRETO_LARGO
